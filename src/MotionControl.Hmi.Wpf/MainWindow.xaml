<Window x:Class="MotionControl.Hmi.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Multi-Axis Motion Control Platform"
        Height="760"
        Width="1120"
        MinHeight="650"
        MinWidth="940">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Virtual Multi-Axis Motion Control Platform"
                       FontSize="28"
                       FontWeight="SemiBold" />
            <TextBlock Text="Software-in-the-loop commissioning of machine workflows and faults"
                       Margin="0,6,0,0"
                       Foreground="DimGray" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="STATE" Foreground="DimGray" />
                    <TextBlock Text="{Binding State}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="X (mm)" Foreground="DimGray" />
                    <TextBlock Text="{Binding X, StringFormat=F3}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Y (mm)" Foreground="DimGray" />
                    <TextBlock Text="{Binding Y, StringFormat=F3}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Z (mm)" Foreground="DimGray" />
                    <TextBlock Text="{Binding Z, StringFormat=F3}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="ACTIVE ALARM"
                               Foreground="DimGray" />
                    <TextBlock Text="{Binding ActiveAlarm}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="5"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="DIAGNOSTICS"
                               Foreground="DimGray" />
                    <TextBlock Text="{Binding WarningCount, StringFormat='Warnings: {0}'}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding IsMoving, StringFormat='Moving: {0}'}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="LightGray"
                BorderThickness="1"
                Padding="12"
                Margin="0,0,0,18">
            <TextBlock Text="{Binding SafetySummary}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <GroupBox Header="Machine commands"
                          Padding="14"
                          Margin="0,0,0,14">
                    <UniformGrid Columns="2" Rows="3">
                        <Button Content="Initialize"
                                Command="{Binding InitializeCommand}"
                                Margin="6"
                                Padding="12" />
                        <Button Content="Home all"
                                Command="{Binding HomeCommand}"
                                Margin="6"
                                Padding="12" />
                        <Button Content="Run inspection"
                                Command="{Binding RunCycleCommand}"
                                Margin="6"
                                Padding="12" />
                        <Button Content="Stop"
                                Command="{Binding StopCommand}"
                                Margin="6"
                                Padding="12" />
                        <Button Content="Reset fault"
                                Command="{Binding ResetFaultCommand}"
                                Margin="6"
                                Padding="12" />
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="Deterministic fault injection"
                          Padding="14">
                    <StackPanel>
                        <Button Content="Arm probe timeout"
                                Command="{Binding InjectProbeTimeoutCommand}"
                                Margin="6"
                                Padding="12" />
                        <Button Content="Clear injected fault"
                                Command="{Binding ClearFaultInjectionCommand}"
                                Margin="6"
                                Padding="12" />
                        <TextBlock Margin="6,16,6,6"
                                   TextWrapping="Wrap"
                                   Text="Scenario controls are simulation-only and are disabled while motion or recovery is active." />
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <GroupBox Grid.Column="1"
                      Header="Latest inspection measurements"
                      Padding="10"
                      Margin="12,0,0,0">
                <DataGrid ItemsSource="{Binding Measurements}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Point"
                                            Binding="{Binding Point}"
                                            Width="*" />
                        <DataGridTextColumn Header="Nominal (mm)"
                                            Binding="{Binding NominalMillimeters, StringFormat=F4}"
                                            Width="*" />
                        <DataGridTextColumn Header="Measured (mm)"
                                            Binding="{Binding MeasuredMillimeters, StringFormat=F4}"
                                            Width="*" />
                        <DataGridTextColumn Header="Error (mm)"
                                            Binding="{Binding ErrorMillimeters, StringFormat=+0.0000;-0.0000;0.0000}"
                                            Width="*" />
                        <DataGridTextColumn Header="Result"
                                            Binding="{Binding Result}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <Border Grid.Row="4"
                BorderBrush="LightGray"
                BorderThickness="1"
                Padding="12"
                Margin="0,20,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
