<Window x:Class="MotionControl.Hmi.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Multi-Axis Motion Control Platform"
        Height="860"
        Width="1260"
        MinHeight="760"
        MinWidth="1080"
        Background="#F4F7FB"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D2D9E2" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="CommandButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Virtual Multi-Axis Motion Control Platform"
                       FontSize="30"
                       FontWeight="SemiBold" />
            <TextBlock Text="Software-in-the-loop commissioning of machine workflows and faults"
                       Margin="0,6,0,0"
                       Foreground="#5A6576" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="STATE" Foreground="#5A6576" />
                    <TextBlock Text="{Binding State}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <Border Margin="0,8,0,0"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            CornerRadius="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E5E7EB" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Ready">
                                        <Setter Property="Background" Value="#DCFCE7" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Automatic">
                                        <Setter Property="Background" Value="#DBEAFE" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Homing">
                                        <Setter Property="Background" Value="#FEF3C7" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Faulted">
                                        <Setter Property="Background" Value="#FEE2E2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"
                                   Text="State quality signal" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="X (mm)" Foreground="#5A6576" />
                    <TextBlock Text="{Binding X, StringFormat=F3}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Y (mm)" Foreground="#5A6576" />
                    <TextBlock Text="{Binding Y, StringFormat=F3}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Z (mm)" Foreground="#5A6576" />
                    <TextBlock Text="{Binding Z, StringFormat=F3}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="CYCLE KPIS"
                               Foreground="#5A6576" />
                    <TextBlock Text="{Binding TotalCycles, StringFormat='Total cycles: {0}'}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PassedCycles, StringFormat='Passed: {0}'}"
                               Margin="0,2,0,0" />
                    <TextBlock Text="{Binding FailedCycles, StringFormat='Failed: {0}'}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="5"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="CYCLE QUALITY"
                               Foreground="#5A6576" />
                    <TextBlock Text="{Binding CyclePassRatePercent, StringFormat='Pass rate: {0:F1}%'}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastCycleDurationMs, StringFormat='Last cycle: {0:F0} ms'}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="ACTIVE ALARM"
                               Foreground="#5A6576" />
                    <TextBlock Text="{Binding ActiveAlarm}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="7"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0">
                <StackPanel>
                    <TextBlock Text="DIAGNOSTICS"
                               Foreground="#5A6576" />
                    <TextBlock Text="{Binding WarningCount, StringFormat='Warnings: {0}'}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding IsMoving, StringFormat='Moving: {0}'}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
            BorderBrush="#D2D9E2"
            BorderThickness="1"
            Background="#FFFFFF"
            CornerRadius="10"
                Padding="12"
                Margin="0,0,0,18">
            <TextBlock Text="{Binding SafetySummary}"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="3" MinHeight="300">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          Margin="0,0,12,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <StackPanel>
                <GroupBox Header="Guided demonstration"
                          Padding="14"
                          Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding BackendName, StringFormat='Backend: {0}'}" />
                        <TextBlock Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding NextAction, StringFormat='Next action: {0}'}" />
                        <UniformGrid Columns="2" Rows="1" Margin="0,12,0,0">
                            <Button Content="Run guided flow"
                                    Command="{Binding RunGuidedDemoCommand}"
                                    Style="{StaticResource CommandButtonStyle}" />
                            <Button Content="Recover to ready"
                                    Command="{Binding RecoverToReadyCommand}"
                                    Style="{StaticResource CommandButtonStyle}" />
                        </UniformGrid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Machine commands"
                          Padding="14"
                          Margin="0,0,0,14">
                    <UniformGrid Columns="2" Rows="3">
                        <Button Content="Initialize"
                                Command="{Binding InitializeCommand}"
                                Style="{StaticResource CommandButtonStyle}" />
                        <Button Content="Home all"
                                Command="{Binding HomeCommand}"
                                Style="{StaticResource CommandButtonStyle}" />
                        <Button Content="Run inspection"
                                Command="{Binding RunCycleCommand}"
                                Style="{StaticResource CommandButtonStyle}" />
                        <Button Content="Stop"
                                Command="{Binding StopCommand}"
                                Style="{StaticResource CommandButtonStyle}" />
                        <Button Content="Reset fault"
                                Command="{Binding ResetFaultCommand}"
                                Style="{StaticResource CommandButtonStyle}" />
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="Fault injection controls"
                          Padding="14">
                    <StackPanel>
                        <TextBlock Text="Select fault" Foreground="#5A6576" />
                        <ComboBox Margin="6,6,6,2"
                                  ItemsSource="{Binding AvailableFaults}"
                                  SelectedItem="{Binding SelectedFault}"
                                  MinHeight="36" />

                        <Button Content="Arm selected fault"
                                Command="{Binding ArmSelectedFaultCommand}"
                                Style="{StaticResource CommandButtonStyle}" />
                        <Button Content="Clear injected fault"
                                Command="{Binding ClearFaultInjectionCommand}"
                                Style="{StaticResource CommandButtonStyle}" />

                        <TextBlock Margin="6,10,6,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding ActiveInjection, StringFormat='Active injection: {0}'}" />
                        <TextBlock Margin="6,10,6,6"
                                   TextWrapping="Wrap"
                                   Text="Scenario controls are simulation-only and are disabled while motion or recovery is active." />
                    </StackPanel>
                </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="140" />
                    <RowDefinition Height="2*" MinHeight="120" />
                </Grid.RowDefinitions>

                <GroupBox Header="Latest inspection measurements"
                          Padding="10"
                          Margin="0,0,0,12">
                    <DataGrid ItemsSource="{Binding Measurements}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Point"
                                                Binding="{Binding Point}"
                                                Width="*" />
                            <DataGridTextColumn Header="Nominal (mm)"
                                                Binding="{Binding NominalMillimeters, StringFormat=F4}"
                                                Width="*" />
                            <DataGridTextColumn Header="Measured (mm)"
                                                Binding="{Binding MeasuredMillimeters, StringFormat=F4}"
                                                Width="*" />
                            <DataGridTextColumn Header="Error (mm)"
                                                Binding="{Binding ErrorMillimeters, StringFormat=+0.0000;-0.0000;0.0000}"
                                                Width="*" />
                            <DataGridTextColumn Header="Result"
                                                Binding="{Binding Result}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Grid.Row="1"
                          Header="Response log"
                          Padding="8">
                    <ListBox ItemsSource="{Binding EventLog}" />
                </GroupBox>
            </Grid>
        </Grid>

        <Border Grid.Row="4"
                BorderBrush="#D2D9E2"
                BorderThickness="1"
                Background="#FFFFFF"
                CornerRadius="10"
                Padding="12"
                Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="5"
                Margin="0,12,0,0"
                Padding="10,8"
                Background="#E9EEF6"
                BorderBrush="#D2D9E2"
                BorderThickness="1"
                CornerRadius="8">
            <TextBlock Text="Demo tip: Use Run guided flow for a clean recording sequence. Use Arm selected fault to switch from normal behavior to deterministic fault demonstrations."
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
